pipeline {
  // Runs on a Jenkins agent (not the controller) that has docker, kubectl, node and envsubst
  agent { label 'docker-agent' }

  environment {
    REGISTRY   = 'docker.io/YOUR_DOCKERHUB_USER'
    IMAGE_NAME = 'demo-app'
    IMAGE      = "${REGISTRY}/${IMAGE_NAME}:${BUILD_NUMBER}"
  }

  options {
    timeout(time: 20, unit: 'MINUTES')
    disableConcurrentBuilds()
  }

  stages {
    stage('Checkout') {
      steps { checkout scm }
    }

    stage('Test') {
      steps { dir('app') { sh 'npm test' } }
    }

    stage('Build image') {
      steps { sh "docker build -t ${IMAGE} app/" }
    }

    stage('Security scan') {
      steps {
        // Fails the build on HIGH/CRITICAL vulnerabilities. Requires trivy on the agent.
        sh "trivy image --exit-code 1 --severity HIGH,CRITICAL ${IMAGE}"
      }
    }

    stage('Push image') {
      steps {
        withCredentials([usernamePassword(credentialsId: 'dockerhub-creds',
                                          usernameVariable: 'DH_USER',
                                          passwordVariable: 'DH_PASS')]) {
          sh '''
            echo "$DH_PASS" | docker login -u "$DH_USER" --password-stdin
            docker push ${IMAGE}
          '''
        }
      }
    }

    stage('Deploy to Kubernetes') {
      steps {
        withCredentials([file(credentialsId: 'kubeconfig', variable: 'KUBECONFIG')]) {
          sh '''
            envsubst < k8s/deployment.yaml | kubectl apply -f -
            kubectl apply -f k8s/service.yaml
            kubectl rollout status deployment/demo-app --timeout=120s
          '''
        }
      }
    }
  }

  post {
    failure {
      withCredentials([file(credentialsId: 'kubeconfig', variable: 'KUBECONFIG')]) {
        sh 'kubectl rollout undo deployment/demo-app || true'
      }
    }
    always { sh "docker rmi ${IMAGE} || true" }
  }
}
